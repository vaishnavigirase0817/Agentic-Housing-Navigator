# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini 3.7 Flash).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CLOUD_PROJECT: Target Google Cloud Project ID for Firestore and Cloud Run.
GOOGLE_CLOUD_PROJECT="agentic-housing-cloud"

# FIRESTORE_DATABASE_ID: (Optional) Firestore database ID, defaults to '(default)'.
FIRESTORE_DATABASE_ID="(default)"

# FIRESTORE_EMULATOR_HOST: (Optional) Host for local Firestore emulator testing.
# FIRESTORE_EMULATOR_HOST="localhost:8080"

# APP_URL: The URL where this applet is hosted on Google Cloud Run.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
